ZOHO_API_BASE=https://mail.zoho.eu
ZOHO_TOKEN_URL=https://accounts.zoho.eu/oauth/v2/token
ZOHO_ACCOUNTS=person@example.com
ZOHO_CLIENT_ID=replace-me
ZOHO_CLIENT_SECRET=replace-me
MAILBRIDGE_INTERVAL=10
MAILBRIDGE_DB=/var/lib/mailbridge/state.sqlite3
MAILBRIDGE_QUEUE=/var/spool/mailbridge/outbound
MAILDIR_ROOT=/vmail
MAILBRIDGE_LOG_LEVEL=INFO

# Normalize account names: @ -> _AT_, dots -> underscores, uppercase.
ZOHO_PERSON_AT_EXAMPLE_COM_ACCOUNT_ID=replace-me
ZOHO_PERSON_AT_EXAMPLE_COM_FOLDER_ID=replace-me
ZOHO_PERSON_AT_EXAMPLE_COM_CLIENT_ID=replace-me
ZOHO_PERSON_AT_EXAMPLE_COM_CLIENT_SECRET=replace-me
ZOHO_PERSON_AT_EXAMPLE_COM_REFRESH_TOKEN=replace-me

