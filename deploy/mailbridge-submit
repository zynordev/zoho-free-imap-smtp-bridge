#!/bin/sh
set -eu
umask 077
queue=${MAILBRIDGE_QUEUE:-/var/spool/mailbridge/outbound}
mkdir -p "$queue"
file=$(mktemp "$queue/message.XXXXXX.eml")
meta="$file.meta"
cleanup() { rm -f "$file" "$meta"; }
# EXIT too: under "set -e" a failing "cat" (full disk, truncated input) skips
# the signal traps entirely, leaving a .eml with no .meta behind. The bridge
# ignores those forever, so without this they just pile up in the queue.
trap cleanup EXIT INT TERM HUP
sender=
recipients=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --sender=*) sender=${1#--sender=} ;;
    # Postfix expands ${recipient} to one argument per recipient, so this flag
    # arrives repeated. Overwriting kept only the last one and silently dropped
    # every other recipient of the same delivery; collect them all instead.
    --recipients=*) recipients="${recipients:+$recipients,}${1#--recipients=}" ;;
  esac
  shift
done
cat > "$file"
printf '%s\n' "sender=$sender" "recipients=$recipients" > "$meta"
trap - EXIT INT TERM HUP

