[Unit]
Description=Zoho Mail API Bridge
After=network-online.target dovecot.service postfix.service
Wants=network-online.target

[Service]
Type=simple
User=mailbridge
Group=mailbridge
EnvironmentFile=/etc/mailbridge/mailbridge.env
ExecStart=/opt/mailbridge/venv/bin/python /opt/mailbridge/mailbridge.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# This lists one example account. For multiple accounts, add every
# configured account's Maildir/new path here too (space-separated) —
# do not just replace the example, or the other accounts' mail
# deliveries will fail under ProtectSystem=strict.
ReadWritePaths=/var/lib/mailbridge /var/spool/mailbridge/outbound /vmail/example.com/user/Maildir/new

[Install]
WantedBy=multi-user.target

