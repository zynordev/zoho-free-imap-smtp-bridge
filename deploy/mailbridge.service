[Unit]
Description=Zoho Mail API Bridge
After=network-online.target dovecot.service postfix.service
Wants=network-online.target

[Service]
Type=simple
User=mailbridge
Group=mailbridge
EnvironmentFile=/etc/mailbridge/mailbridge.env
ExecStart=/opt/mailbridge/venv/bin/python /opt/mailbridge/mailbridge.py
Restart=on-failure
RestartSec=10
# Directories the bridge creates under each account's Maildir (new
# subfolders included) must stay group-writable so Dovecot's vmail
# user — a different uid, sharing access only via a common group and
# setgid on the account's home directory — can move/index mail there.
# The default umask (022) would strip that group-write bit.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# List each account's HOME directory (the one holding Maildir), not the
# Maildir itself. The bridge creates Maildir and its per-folder
# subdirectories on demand, and under ProtectSystem=strict every path
# named here must already exist when the unit starts — naming a
# not-yet-created Maildir deadlocks the service (it cannot start, so it
# cannot create the directory that would let it start), failing with
# status=226/NAMESPACE. The account home is created during setup, so it
# is always there.
#
# This lists one example account; for multiple accounts add every
# configured account's home here too (space-separated) — do not just
# replace the example, or the other accounts' deliveries will fail.
ReadWritePaths=/var/lib/mailbridge /var/spool/mailbridge/outbound /vmail/example.com/user

[Install]
WantedBy=multi-user.target

